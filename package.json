{
  "name": "warehouse-desktop-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Abdullah System",
  "description": "Native Warehouse Management Desktop Application",
  "scripts": {
    "server": "node backend/server.js",
    "client": "vite",
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run client\" --names \"API,CLIENT\" --prefix-colors \"blue,green\"",
    "build": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.abdullah.warehouse",
    "productName": "Warehouse Manager",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
